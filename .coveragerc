[run]
# Source for coverage measurement - utiliser . pour avoir des chemins src/...
source = .

# Inclure uniquement src/
include = src/*

# Omit heavy modules / files that are not practical to unit-test locally
omit =
    main.py
    src/*/upload_service.py
    src/*/upload_api.py
    src/*/main_*.py
    src/*/scanner.py
    src/*/security_api.py
    src/*/security_service.py
    src/*/database.py
    src/*/models.py
    src/*/init_database.sql
    src/*/Dockerfile
    src/*/templates/*
    src/*/static/*
    src/ui/*
    tests/*

# Exclure les modules lourds ou non testés pour concentrer la mesure sur les
# fonctions unitaires testées (sécurité, storage_manager, crypto, schemas, etc.).
    src/auth/auth_api.py
    src/auth/auth_service.py
    src/auth/crud.py
    src/auth/kms.py
    src/auth/models.py
    src/videos/expiration_engine.py
    src/videos/metadata_mapper.py
    src/videos/security.py
    src/videos/upload_api.py
    src/videos/upload_service.py
    src/videos/test_upload_service.py
    src/videos/database_old.py
    src/security/client.py
    src/security/jwt_validator.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:  # pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

precision = 2
show_missing = True

[html]
directory = htmlcov

[xml]
output = coverage.xml

[paths]
# Permet à SonarCloud de mapper les chemins correctement
source =
    src/
    */src/
