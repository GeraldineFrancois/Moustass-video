# ==========================================
# MOUSTASS VIDEO - CONFIGURATION EXAMPLE
# ==========================================
# 
# ⚠️  IMPORTANT : 
# 1. Copiez ce fichier en .env : cp .env.example .env
# 2. Changez TOUS les mots de passe par des valeurs sécurisées
# 3. Ne commitez JAMAIS le fichier .env (déjà dans .gitignore)
#
# Générez des mots de passe forts avec :
# openssl rand -base64 32
#
# ==========================================

# ==========================================
# JWT SECRET (utilisé pour signer les tokens)
# ==========================================
JWT_SECRET=CHANGEZ_CETTE_CLE_AVEC_UNE_VALEUR_ALEATOIRE_LONGUE_ET_SECURISEE

# ==========================================
# MYSQL ROOT
# ==========================================
MYSQL_ROOT_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_ROOT_MYSQL

# ==========================================
# BASE DE DONNÉES VIDÉOS
# ==========================================
MYSQL_DATABASE=videos_db
VIDEO_DB_USER=video_user
VIDEO_DB_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_VIDEO
VIDEO_DB_HOST=mysql
VIDEO_DB_PORT=3306
VIDEO_DB_NAME=videos_db

# URL complète de connexion (construite automatiquement)
VIDEO_DATABASE_URL=mysql+pymysql://${VIDEO_DB_USER}:${VIDEO_DB_PASSWORD}@${VIDEO_DB_HOST}:${VIDEO_DB_PORT}/${VIDEO_DB_NAME}

# ==========================================
# BASE DE DONNÉES AUTHENTIFICATION
# ==========================================
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_AUTH
AUTH_DB_NAME=auth_db

# ==========================================
# BASE DE DONNÉES SÉCURITÉ
# ==========================================
SECURITY_DB_USER=security_user
SECURITY_DB_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_SECURITY

# ==========================================
# CONFIGURATION OPTIONNELLE
# ==========================================
RSA_KEY_SIZE=3072
VIDEO_EXPIRATION_DAYS=60
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8002

# ==========================================
# SNYK (Scanning de sécurité)
# ==========================================
# Optionnel - obtenez un token sur https://snyk.io
SNYK_TOKEN=

# ==========================================
# SONARQUBE (Analyse de code)
# ==========================================
# Optionnel
SONAR_TOKEN=
SONAR_HOST_URL=http://localhost:9000

