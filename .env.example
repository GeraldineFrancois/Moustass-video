# ==========================================
# MOUSTASS VIDEO - CONFIGURATION TEMPLATE
# ==========================================
# 
# IMPORTANT - Lire la documentation:
# Chaque développeur/collègue DOIT avoir son propre .env local
# Ce fichier est un TEMPLATE PUBLIC
# Le fichier .env réel est TOUJOURS ignoré par git (.gitignore)
#
# Voir: SETUP_CUSTOM_PASSWORD.md pour les instructions détaillées
#
# ==========================================

# ==========================================
# JWT SECRET (généré aléatoirement)
# ==========================================
# Remplacez ou utilisez ./generate-env.sh pour auto-générer
JWT_SECRET=votre-secret-jwt-aleatoire-64-caracteres-min

# ==========================================
# MYSQL - 2 OPTIONS POSSIBLES
# ==========================================
# 
# OPTION 1: MySQL via Docker (recommandé en dev)
# Le mot de passe root sera généré aléatoirement (sécurisé)
# Les comptes service (video_user, auth_user, security_user)
# seront créés par les scripts init_database.sql
#
# OPTION 2: MySQL existant sur votre machine
# Remplacez les valeurs par vos credentials réels
# Les comptes service doivent exister dans votre MySQL

MYSQL_ROOT_PASSWORD=votre-root-password-si-mysql-existant

# ==========================================
# BASE DE DONNÉES VIDÉOS
# ==========================================
MYSQL_DATABASE=videos_db
VIDEO_DB_USER=video_user
VIDEO_DB_PASSWORD=votre-password-si-mysql-existant
VIDEO_DB_HOST=mysql
VIDEO_DB_PORT=3306
VIDEO_DB_NAME=videos_db
VIDEO_DATABASE_URL=mysql+pymysql://${VIDEO_DB_USER}:${VIDEO_DB_PASSWORD}@${VIDEO_DB_HOST}:${VIDEO_DB_PORT}/${VIDEO_DB_NAME}

# ==========================================
# BASE DE DONNÉES AUTHENTIFICATION
# ==========================================
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=votre-password-si-mysql-existant
AUTH_DB_NAME=auth_db
AUTH_DB_HOST=mysql
AUTH_DB_PORT=3306

# ==========================================
# BASE DE DONNÉES SÉCURITÉ
# ==========================================
SECURITY_DB_USER=security_user
SECURITY_DB_PASSWORD=votre-password-si-mysql-existant
SECURITY_DB_NAME=security_db

# ==========================================
# CONFIGURATION OPTIONNELLE
# ==========================================
RSA_KEY_SIZE=3072
VIDEO_EXPIRATION_DAYS=60
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8002

# ==========================================
# SNYK (Scanning de sécurité)
# ==========================================
# Optionnel - obtenez un token sur https://snyk.io
SNYK_TOKEN=

# ==========================================
# SONARQUBE (Analyse de code)
# ==========================================
# Optionnel
SONAR_TOKEN=
SONAR_HOST_URL=http://localhost:9000

