# Configuration d'environnement pour Moustass Video Services
# Copier ce fichier en .env et adapter les valeurs

# Secret JWT (utilisé par Auth Service et Video Service)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Base de données Auth Service (SQLite par défaut)
# AUTH_DATABASE_URL=sqlite:///./dev.db
# Pour PostgreSQL:
# AUTH_DATABASE_URL=postgresql://user:password@localhost/auth_db

# Base de données Video Service
# Format: mysql+pymysql://user:password@host:port/database
VIDEO_DATABASE_URL=mysql+pymysql://video_user:video_password@mysql:3306/videos_db

# Variables optionnelles
# DEBUG=True
# LOG_LEVEL=INFO
RSA_KEY_SIZE=3072
VIDEO_EXPIRATION_DAYS=60

# CORS (pour accès du frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8002
