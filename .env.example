# Configuration du Service Upload Vidéo

# Base de données MySQL
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=videos_db

# Service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8002
SERVICE_ENV=development

# Upload
MAX_FILE_SIZE=524288000  # 500MB en bytes
UPLOAD_DIR=uploads
ALLOWED_EXTENSIONS=.mp4,.ts

# Sécurité
RSA_KEY_SIZE=3072
VIDEO_EXPIRATION_DAYS=60

# CORS (pour accès du frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8002
