# ==========================================
# MOUSTASS VIDEO - CONFIGURATION LOCALE
# ==========================================
# ⚠️  CONFIDENTIEL - Ne JAMAIS commiter (voir .gitignore)
# À CHAQUE DEVELOPPEUR DE REMPLIR AVEC SES CREDENTIALS
# 
# Utiliser: ./generate-env-interactive.sh
# Documentation: SETUP_CUSTOM_PASSWORD.md
# ==========================================

# JWT Secret (généré aléatoirement via generate-env-interactive.sh)
JWT_SECRET=

# MySQL Root Password
# OPTION 1: MySQL via Docker (laisse générer automatiquement)
# OPTION 2: MySQL existant (remplace par ton vrai password)
MYSQL_ROOT_PASSWORD=

# Base de données Vidéos
MYSQL_DATABASE=videos_db
VIDEO_DB_USER=video_user
VIDEO_DB_PASSWORD=
VIDEO_DB_HOST=mysql
VIDEO_DB_PORT=3306
VIDEO_DB_NAME=videos_db
VIDEO_DATABASE_URL=mysql+pymysql://${VIDEO_DB_USER}:${VIDEO_DB_PASSWORD}@${VIDEO_DB_HOST}:${VIDEO_DB_PORT}/${VIDEO_DB_NAME}

# Base de données Authentification
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=
AUTH_DB_NAME=auth_db
AUTH_DB_HOST=mysql
AUTH_DB_PORT=3306

# Base de données Sécurité
SECURITY_DB_USER=security_user
SECURITY_DB_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Configuration optionnelle
RSA_KEY_SIZE=3072
VIDEO_EXPIRATION_DAYS=60
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8002

# Scans de sécurité (optionnel)
SNYK_TOKEN=
SONAR_TOKEN=
SONAR_HOST_URL=http://localhost:9000
